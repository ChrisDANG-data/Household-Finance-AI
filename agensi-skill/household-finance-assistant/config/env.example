# Household Finance Assistant — connection settings
# Set these as environment variables in your shell or agent config.
# Never commit a real key.

# Required. Create it in the web app: sign in -> "API keys" -> Create key.
HFI_API_KEY=hfi_replace_with_your_key

# Optional. Only change this if you host your own copy of the app.
HFI_BASE_URL=https://household-financial-web.vercel.app
